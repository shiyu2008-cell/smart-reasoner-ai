# Docker忽略文件

# 依赖目录
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 构建输出
.next
out
dist

# 测试文件
__tests__
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# 环境文件（除了必要的）
.env.local
.env.development
.env.test
.env.production
.env.docker

# 编辑器文件
.vscode
.idea
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# 日志文件
logs
*.log

# 临时文件
tmp
temp

# 文档
*.md
docs/

# Docker相关文件（除了必要的）
Dockerfile
docker-compose.yml
.dockerignore

# 数据库文件（生产环境应该使用外部数据库）
*.db
*.sqlite
*.sqlite3